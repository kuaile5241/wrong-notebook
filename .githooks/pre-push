#!/bin/sh
# 每个公开引用都要检查文件路径历史和公开基线后的全部可达对象。
set -eu
remote_name=$1
remote_url=$2
if [ "$remote_name" != github ]; then
    case "$remote_url" in
        *github.com*) ;;
        *) exit 0 ;;
    esac
fi
repo=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
while read -r local_ref local_oid remote_ref remote_oid; do
    [ "$local_oid" = "$zero" ] && continue
    "${WRONG_NOTEBOOK_PYTHON:-python3}" "$repo/scripts/check-public-history.py" "$local_oid"
done

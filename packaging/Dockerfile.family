# 从已验证的运行镜像构建家庭版，避免更改宿主机依赖与其他网站。
ARG RUNTIME_IMAGE=ghcr.io/margrop/wrong-notebook:2026.10.26
FROM ${RUNTIME_IMAGE} AS builder
USER root
WORKDIR /build
ENV NODE_ENV=development NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --include=dev --registry=https://registry.npmjs.org --no-audit --no-fund
COPY . .
ENV DATABASE_URL=file:/build/prisma/dev.db
RUN npx --no-install prisma generate \
    && npm run lint \
    && npm test -- --maxWorkers=2 --testTimeout=30000 --hookTimeout=30000 \
    && npx --no-install tsc scripts/rebuild-system-tags.ts --outDir dist-scripts --esModuleInterop --resolveJsonModule --skipLibCheck --module commonjs --target ES2020 \
    && npx --no-install prisma migrate deploy \
    && npx --no-install prisma db seed \
    && node dist-scripts/scripts/rebuild-system-tags.js \
    && NODE_ENV=production npm run build

FROM ${RUNTIME_IMAGE} AS runner
USER root
WORKDIR /app
ARG APP_REVISION=unknown
ARG APP_VERSION=2026.10.29-1
ENV APP_REVISION=${APP_REVISION} APP_VERSION=${APP_VERSION} NODE_ENV=production PRESERVE_EXISTING_DATA=true
LABEL org.opencontainers.image.source="https://github.com/kuaile5241/wrong-notebook" \
      org.opencontainers.image.revision="${APP_REVISION}" \
      org.opencontainers.image.version="${APP_VERSION}"
# 只清理新镜像层中的旧程序文件，不接触宿主机挂载的数据和设置。
RUN rm -rf .next public prisma dist-scripts node_modules
COPY --from=builder --chown=nextjs:nodejs /build/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /build/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /build/public ./public
COPY --from=builder --chown=nextjs:nodejs /build/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=nextjs:nodejs /build/node_modules/prisma ./node_modules/prisma
COPY --from=builder --chown=nextjs:nodejs /build/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder --chown=nextjs:nodejs /build/prisma ./prisma
COPY --from=builder --chown=nextjs:nodejs /build/dist-scripts ./dist-scripts
COPY --from=builder --chown=nextjs:nodejs /build/scripts/seed-admin.js ./dist-scripts/scripts/seed-admin.js
COPY --from=builder --chown=nextjs:nodejs --chmod=755 /build/docker-entrypoint.sh ./docker-entrypoint.sh
COPY --from=builder --chown=nextjs:nodejs /build/https-server.js ./https-server.js
